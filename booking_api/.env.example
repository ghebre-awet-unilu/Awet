# Copy this file to .env and fill in real values. Never commit .env.

PORT=3000

# Supabase Postgres (Project Settings -> Database -> Connection string, "Transaction pooler")
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# PayPal REST app (developer.paypal.com). Sandbox for testing:
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Admin
ADMIN_EMAIL=admin@example.com
SETUP_TOKEN_HOURS=24
ADMIN_SESSION_SECRET=<run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))">
ADMIN_SESSION_HOURS=8

# Public website address (used for PayPal return links and setup emails)
SITE_URL=http://localhost:1313/luxehome
ALLOWED_ORIGINS=http://localhost:1313,https://<github-user>.github.io

# Sale properties are reserved with this deposit (rentals pay first month)
SALE_DEPOSIT_EUR=1000

# Gmail SMTP (use a Google "App password")
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=LuxeHome <you@gmail.com>
